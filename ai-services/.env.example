GEMINI_API_KEY=
# Debe coincidir con AI_SERVICE_TOKEN del backend (vacío = sin control, solo dev)
AI_SERVICE_TOKEN=
# Los flash no-lite (3.6/3.7/3.8-flash, flash-latest) devuelven 503 "high
# demand" constante en cuentas gratuitas; los *-flash-lite sí responden.
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# <= 2000 para que pgvector cree el indice HNSW; se trunca via output_dimensionality.
EMBEDDING_DIMENSIONS=1536
# Embedding por chunk: concurrencia, tope de llamadas/min y reintentos ante 429/503
EMBEDDING_CONCURRENCY=4
EMBEDDING_REQUESTS_PER_MINUTE=40
EMBEDDING_MAX_RETRIES=8
EMBEDDING_RETRY_MAX_DELAY_SECONDS=65

# Reintentos con backoff exponencial ante 503/429 del proveedor.
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY_SECONDS=2.0
LLM_RETRY_MAX_DELAY_SECONDS=30.0

DATABASE_URL=postgresql://eduai:eduai@localhost:5432/eduai
REDIS_URL=redis://localhost:6379

# Vector store: pgvector | pinecone
VECTOR_STORE=pgvector
PINECONE_API_KEY=""
PINECONE_INDEX=eduai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

REDIS_CACHE_TTL_SECONDS=3600
RETRIEVAL_TOP_K=5
# Umbral mínimo de similitud (0.0-1.0). 0.0 = sin filtro (comportamiento legacy).
# Tras calibración con ai-services/scripts/calibrate_threshold.py se recomienda fijar un valor > 0.
RETRIEVAL_MIN_SCORE=0.0
