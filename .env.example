# El código nunca tiene valores hardcodeados, cada servicio copia este archivo cómo su propio .env y lo completa con lo pertinente.

DATABASE_URL=postgresql://eduai:eduai@localhost:5432/eduai?schema=public

REDIS_URL=redis://localhost:6379

# Vector store del tutor IA: pgvector | pinecone
VECTOR_STORE=pgvector
PINECONE_API_KEY=
PINECONE_INDEX=eduai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LLM_PROVIDER=gemini
OPENAI_API_KEY=
JWT_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=eduai
EMAIL_API_KEY=


