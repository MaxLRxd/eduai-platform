# El código nunca tiene valores hardcodeados: cada servicio copia este archivo como su propio .env y lo completa.

# Base de datos
DATABASE_URL=postgresql://eduai:eduai@localhost:5432/eduai?schema=public

# Redis (caché)
REDIS_URL=redis://localhost:6379

# Vector store del tutor IA: pgvector | pinecone
VECTOR_STORE=pgvector
PINECONE_API_KEY=
PINECONE_INDEX=eduai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LLM_PROVIDER=gemini
OPENAI_API_KEY=

# Auth
JWT_SECRET=min-16-chars-for-dev

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=eduai

# Email
EMAIL_API_KEY=
EMAIL_FROM=

# Servicios (compose)
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:3000
