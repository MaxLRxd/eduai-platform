# ============================================================================
# EduAI · Variables de entorno (fuente única para docker compose)
# `npm run dev` (= docker compose up) inyecta este archivo vía env_file a
# backend, ai-service y frontend. Los hosts internos (db, redis, ai-service)
# los inyecta compose en `environment:` y SOBRESCRIBEN los valores de acá,
# que quedan como referencia/fallback para el modo local (npm run dev:local).
# El código nunca tiene valores hardcodeados: este archivo es la fuente.
# ============================================================================

# --- docker compose · infra (no es env de las apps; interpola docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend + ai-service · compartidas (compose las reemplaza por hosts internos) ---
DATABASE_URL=postgresql://eduai:eduai@localhost:5432/eduai?schema=public
REDIS_URL=redis://localhost:6379

# --- Backend (Node.js/Express · backend/src/config/env.ts) ---
JWT_SECRET=
PORT=3000
CORS_ORIGIN=http://localhost:5173
REFRESH_TTL_DAYS=7
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=
# Cloudflare R2 (almacenamiento de archivos; hoy la subida usa disco local UPLOAD_DIR)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=eduai
# Subida de archivos: destino local de los binarios + tamaño máximo (MB)
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=50

# --- ai-service (Python/FastAPI · ai-services/src/config/settings.py) ---
GEMINI_API_KEY=
# Modelos "flash" no-lite (3.6/3.7/3.8-flash, flash-latest) devuelven 503
# "high demand" de forma constante en cuentas gratuitas. Los *-flash-lite sí
# responden. Si tu key da 503, probá con gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072
LLM_PROVIDER=gemini
# Reintentos con backoff exponencial ante 503/429 del proveedor.
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY_SECONDS=2.0
LLM_RETRY_MAX_DELAY_SECONDS=30.0
VECTOR_STORE=pgvector
# Solo si VECTOR_STORE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=eduai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine
REDIS_CACHE_TTL_SECONDS=3600
RETRIEVAL_TOP_K=5

# --- Frontend (React/Vite · solo VITE_* llega al bundle) ---
VITE_API_URL=http://localhost:3000

# --- Sin consumidor en el código hoy (reservadas para notificaciones) ---
EMAIL_API_KEY=
EMAIL_FROM=