{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EduAI frontend — React 18 + TypeScript + Vite + Tailwind",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
