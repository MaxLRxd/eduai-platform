generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ALUMNO
  PROFESOR
  ADMIN
}

enum ActivityType {
  MULTIPLE_CHOICE
  DESARROLLO_ESCRITO
  ARCHIVO
}

enum SubmissionStatus {
  ENTREGADO
  CORREGIDO
  REVISADO
  DEVUELTO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  lastName     String
  role         Role     @default(ALUMNO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teaches         Course[]        @relation("CourseTeacher")
  enrollments     Enrollment[]
  submissions     Submission[]    @relation("StudentSubmissions")
  gradedBy        Grade[]         @relation("GradedBy")
  attendance      Attendance[]    @relation("AttendanceStudent")
  chats           Chat[]
  notifications   Notification[]
}

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  teacherId   String?
  teacher     User?    @relation("CourseTeacher", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    Section[]
  activities  Activity[]
  enrollments Enrollment[]
  attendance  Attendance[]
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Section {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course    Course     @relation(fields: [courseId], references: [id])
  materials Material[]
}

model Material {
  id        String   @id @default(cuid())
  sectionId String
  title     String
  type      String
  url       String
  indexedAi Boolean  @default(false)
  createdAt DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id])
}

model Activity {
  id          String       @id @default(cuid())
  courseId    String
  title       String
  description String?
  type        ActivityType
  dueDate     DateTime?
  createdAt   DateTime     @default(now())

  course      Course       @relation(fields: [courseId], references: [id])
  submissions Submission[]
  rubric      Rubric?
}

model Rubric {
  id         String   @id @default(cuid())
  activityId String   @unique
  criteria   Json     // [{ name, description, weight }]
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id])
}

model Submission {
  id         String           @id @default(cuid())
  activityId String
  studentId  String
  content    String?
  fileUrl    String?
  status     SubmissionStatus @default(ENTREGADO)
  aiFeedback Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  activity Activity @relation(fields: [activityId], references: [id])
  student  User     @relation("StudentSubmissions", fields: [studentId], references: [id])
  grade    Grade?
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  grabberId    String
  value        Float
  comment      String?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
  teacher   User       @relation("GradedBy", fields: [grabberId], references: [id])
}

model Attendance {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  date      DateTime
  present   Boolean  @default(true)

  student User   @relation("AttendanceStudent", fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([courseId, studentId, date])
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  createdAt DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id])
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}