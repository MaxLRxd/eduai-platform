# Contenido de ejemplo — nunca valores reales
DATABASE_URL=
REDIS_URL=
# Local (ai-service corriendo con `npm run dev:local` o uvicorn en :8000).
# En docker compose se usa http://ai-service:8000 (inyectado por el propio compose).
AI_SERVICE_URL=http://localhost:8000
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# API S3 de R2, usada para subir/borrar: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_NAME=eduai
# URL PÚBLICA del bucket (dominio custom o https://pub-<hash>.r2.dev).
# Si queda vacía se usa R2_ENDPOINT/R2_BUCKET_NAME (NO público).
R2_PUBLIC_URL=
JWT_SECRET=
PORT=3000

EMAIL_PROVIDER=none
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
