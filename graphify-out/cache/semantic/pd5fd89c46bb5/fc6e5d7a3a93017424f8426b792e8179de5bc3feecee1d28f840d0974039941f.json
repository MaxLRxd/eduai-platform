{"nodes": [{"id": "implementation_guide", "label": "EduAI Implementation Document v1.1", "file_type": "document", "source_file": "IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_backend_layers", "label": "Backend Layered Architecture (routes/controllers/services/base)", "file_type": "rationale", "source_file": "IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each layer has a specific job and does not meddle in another's: routes only receive HTTP and call the controller; controllers validate input and call services; services hold all business logic and know nothing about HTTP."}, {"id": "implementation_ai_service_architecture", "label": "AI Service (Python/FastAPI) Architecture", "file_type": "concept", "source_file": "IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "implementation_adjacent_layer_rule", "label": "Adjacent-Layer Communication Rule", "file_type": "rationale", "source_file": "IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each layer only talks to the adjacent layer; e.g. swapping ChromaDB for Pinecone touches only retrieval_service.py and swapping OpenAI for Claude touches only llm_service.py, so upper layers never notice the change."}, {"id": "implementation_redis_caching", "label": "Redis Caching of Tutor Queries", "file_type": "rationale", "source_file": "IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache the most frequent tutor questions/answers so the same question about the same material is served from cache without calling the LLM, reducing token cost and latency; keys written with TTL to avoid saturating memory; backend, ai-service and frontend consume it via REDIS_URL."}, {"id": "implementation_prompt_separation", "label": "Prompts Kept Out of Code", "file_type": "rationale", "source_file": "IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System prompts are stored separately from code because they change frequently during development."}, {"id": "implementation_env_golden_rule", "label": "No Hardcoded Configuration", "file_type": "rationale", "source_file": "IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Golden rule: code never contains a hard-coded value (no API key, URL or password); everything comes from the environment and services must fail explicitly at startup if a required variable is missing."}], "edges": [{"source": "implementation_guide", "target": "docker_compose_config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "IMPLEMENTATION.md", "source_location": null, "weight": 1.0}, {"source": "implementation_guide", "target": "_github_workflows_ci_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "IMPLEMENTATION.md", "source_location": null, "weight": 1.0}, {"source": "implementation_guide", "target": "frontend_index_html", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "IMPLEMENTATION.md", "source_location": null, "weight": 1.0}, {"source": "implementation_guide", "target": "ai_services_requirements_deps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "IMPLEMENTATION.md", "source_location": null, "weight": 1.0}, {"source": "implementation_guide", "target": "ai_services_requirements_dev_deps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "IM