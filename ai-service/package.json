{
  "name": "ai-service",
  "version": "0.1.0",
  "private": true,
  "description": "EduAI AI service — microservicio de IA (FastAPI, RAG + LLM)",
  "scripts": {
    "dev:local": "uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload",
    "setup": "python -m venv .venv && .venv\\Scripts\\pip install -r requirements-dev.txt",
    "test": "python -m pytest tests",
    "lint": "python -m ruff check src tests",
    "format": "python -m ruff format src tests"
  }
}